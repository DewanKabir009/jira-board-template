---
import TicketExplorerIsland from "../components/TicketExplorerIsland";
import DashboardLayout from "../layouts/DashboardLayout.astro";
import "../styles/dashboard.css";

const dataUrl = import.meta.env.PUBLIC_DASHBOARD_DATA_URL || "../dashboard-data.json";
---

<DashboardLayout title="Modern Jira Dashboard" dataUrl={dataUrl}>
  <TicketExplorerIsland client:load dataUrl={dataUrl} />
</DashboardLayout>
